---
import Base from '../../layouts/Base.astro';
import { getProjects, getPhases, headings } from '../../lib/content.mjs';
import { renderMarkdown, slugify } from '../../lib/markdown.mjs';

export function getStaticPaths() {
  return getProjects().map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}
const { slug } = Astro.props;
const p = getProjects().find((x) => x.slug === slug);
const phase = getPhases().find((x) => x.n === p.phase);
const html = renderMarkdown(p.body, p.file);
const toc = headings(p.body);
const statusLabel: Record<string, string> = { done: 'DONE', active: 'ACTIVE', partial: 'STARTED', ahead: 'AHEAD' };
---
<Base title={`${p.code} · ${p.name}`} source={p.file}>
  <section class="page-head">
    <div class="hero-text">
      <span class="label">Project {p.code} · Phase {p.phase}</span>
      <h1 class="page-title">{p.name}</h1>
      <p class="lede">{p.pitch}</p>
    </div>
    <div class="spec">
      <div class="spec-title">PROJECT SPECIFICATIONS</div>
      <dl>
        <dt>Phase</dt><dd><a href={phase.href}>{phase.n} · {phase.short}</a></dd>
        <dt>Weeks</dt><dd>{p.weeks}</dd>
        <dt>Repo</dt><dd>{p.repo.href ? <a href={p.repo.href}>{p.repo.name}</a> : p.repo.name || '—'}</dd>
        <dt>Status</dt><dd>{p.status.glyph} {p.status.label}</dd>
        <dt>Phase progress</dt><dd>{phase.done}/{phase.total}</dd>
      </dl>
    </div>
  </section>

  {toc.length > 2 && (
    <nav class="mono" style="font-size:12px;display:flex;flex-wrap:wrap;gap:4px 16px" aria-label="On this page">
      {toc.map((h) => <a href={`#${slugify(h)}`}>§ {h}</a>)}
    </nav>
  )}

  <div class="prose" set:html={html} />

  <section class="section">
    <div class="group-head">
      <h2><span class="label" style="margin-right:10px">Built from</span>Weeks &amp; mini-projects</h2>
      <a class="mono" style="font-size:12px" href={phase.href}>→ Phase {phase.n} page</a>
    </div>
    <div class="table-wrap" style="border-top:0">
      <table class="skill-table">
        <thead><tr><th>Week</th><th>Topic</th><th>Mini-project</th><th style="text-align:right">Week status</th></tr></thead>
        <tbody>
          {phase.weeks.map((w) => (
            <tr>
              <td class="mono" style="font-size:12.5px"><a href={w.href}>{w.code}</a></td>
              <td><a href={w.href} style="text-decoration:none;color:inherit">{w.title}</a></td>
              <td>{w.mini ? <><a class="mini-name" href={w.mini.href}>{w.mini.name}</a>{w.mini.status === 'done' && <span class="shipped"> ✓ shipped</span>}{w.mini.repo && <> · <a href={w.mini.repo}>repo ↗</a></>}</> : '—'}</td>
              <td class="st"><span class={`chip ${w.status}`}>{statusLabel[w.status]}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>
